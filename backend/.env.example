# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/collegestay?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_NAME=cs_token

# Brevo (Sendinblue) — Transactional Email API (HTTPS, not SMTP)
# Get your API key from Brevo dashboard -> Settings -> SMTP & API -> API Keys.
# EMAIL_USER must be a verified sender in your Brevo account
# (Settings -> Senders & IP -> Senders).
BREVO_API_KEY=your_brevo_api_key
EMAIL_USER=no-reply@yourdomain.com
EMAIL_FROM_NAME=CollegeStay
OTP_EXPIRE_MINUTES=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
